---
import type { Dictionary } from '../i18n';
import { largestHeroSrc, loadHeroImages } from '../lib/hero-image';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
const hero = await loadHeroImages();
---

<section class="hero" data-testid="hero">
  <div class="hero-media">
    <picture>
      <source type="image/avif" srcset={hero.avif.srcSet.attribute} sizes={hero.sizes} />
      <source type="image/webp" srcset={hero.webp.srcSet.attribute} sizes={hero.sizes} />
      <img
        src={largestHeroSrc(hero.jpeg)}
        srcset={hero.jpeg.srcSet.attribute}
        alt={hero.alt}
        sizes={hero.sizes}
        width={hero.jpeg.attributes.width}
        height={hero.jpeg.attributes.height}
        loading="eager"
        fetchpriority="high"
        decoding="sync"
        data-placeholder="image"
        class="hero-still"
      />
    </picture>
  </div>
  <div class="hero-scrim"></div>
  <div class="hero-copy">
    <p class="eyebrow">{dict.hero.eyebrow.text}</p>
    <h1>
      <span>{dict.hero.titleLead.text}</span>
      <em>{dict.hero.titleEm.text}</em>
    </h1>
    <p class="lede">{dict.hero.lede.text}</p>
    <div class="hero-actions">
      <a class="btn" data-testid="cta-primary" href="#monte-seu-roteiro">
        {dict.hero.cta.text}
      </a>
      <a class="text-link" href="#experiencias">
        {dict.hero.secondary.text}
      </a>
    </div>
  </div>
  <div class="cue" aria-hidden="true"></div>
</section>
