---
import type { Locale } from '../config/whatsapp';
import type { Dictionary } from '../i18n';
import { largestHeroSrc, loadHeroImages } from '../lib/hero-image';

interface Props {
  locale: Locale;
  dict: Dictionary;
}

const { locale, dict } = Astro.props;
const hero = await loadHeroImages(locale);
const base = import.meta.env.BASE_URL;
---

<section class="hero" data-testid="hero">
  <div class="hero-media">
    <picture>
      <source type="image/avif" srcset={hero.avif.srcSet.attribute} sizes={hero.sizes} />
      <source type="image/webp" srcset={hero.webp.srcSet.attribute} sizes={hero.sizes} />
      <img
        src={largestHeroSrc(hero.jpeg)}
        srcset={hero.jpeg.srcSet.attribute}
        alt={hero.alt}
        sizes={hero.sizes}
        width={hero.jpeg.attributes.width}
        height={hero.jpeg.attributes.height}
        loading="eager"
        fetchpriority="high"
        decoding="sync"
        data-placeholder="image"
        class="hero-still"
      />
    </picture>
    <video
      class="hero-clip"
      data-hero-video
      data-src-webm={`${base}media/hero.webm`}
      data-src-mp4={`${base}media/hero.mp4`}
      data-src-webm-narrow={`${base}media/hero-narrow.webm`}
      data-src-mp4-narrow={`${base}media/hero-narrow.mp4`}
      muted
      loop
      playsinline
      autoplay
      preload="none"
      aria-hidden="true"
    ></video>
  </div>
  <div class="hero-scrim"></div>
  <div class="hero-copy">
    <p class="eyebrow">{dict.hero.eyebrow.text}</p>
    <h1>
      <span>{dict.hero.titleLead.text}</span>
      <em>{dict.hero.titleEm.text}</em>
    </h1>
    <p class="lede">{dict.hero.lede.text}</p>
    <div class="hero-actions">
      <a class="btn" data-testid="cta-primary" href="#plan">
        {dict.hero.cta.text}
      </a>
      <a class="text-link" href="#experiencias">
        {dict.hero.secondary.text}
      </a>
      <button
        type="button"
        class="hero-playback"
        data-hero-playback
        data-label-pause={dict.hero.pause.text}
        data-label-play={dict.hero.play.text}
        hidden
        aria-pressed="false"
      >
        {dict.hero.pause.text}
      </button>
    </div>
  </div>
  <div class="cue" aria-hidden="true"></div>
</section>
