---
import type { Locale } from '../config/whatsapp';
import type { Dictionary } from '../i18n';
import Experiences from './Experiences.astro';
import Hero from './Hero.astro';
import Manifesto from './Manifesto.astro';
import Method from './Method.astro';
import Plan from './Plan.astro';
import Territories from './Territories.astro';

interface Props {
  locale: Locale;
  dict: Dictionary;
  untranslated?: boolean;
}

const { locale, dict, untranslated = false } = Astro.props;
---

<main id="main" lang={untranslated ? 'pt-BR' : undefined}>
  <Hero locale={locale} dict={dict} />
  <Manifesto dict={dict} />
  <Territories locale={locale} dict={dict} />
  <Experiences locale={locale} dict={dict} />
  <Method dict={dict} />
  <Plan dict={dict} locale={locale} />
</main>
