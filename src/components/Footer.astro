---
import { WHATSAPP_DISPLAY, whatsappHref, type Locale } from '../config/whatsapp';
import type { Dictionary } from '../i18n';
import { localeHref } from '../lib/paths';
import LocaleSwitch from './LocaleSwitch.astro';

interface Props {
  dict: Dictionary;
  locale: Locale;
  untranslated?: boolean;
}

const { dict, locale, untranslated = false } = Astro.props;
const year = new Date().getFullYear();
const creditsHref = `${import.meta.env.BASE_URL}creditos/`;
const copyLang = untranslated ? 'pt-BR' : undefined;
---

<footer class="footer" data-testid="footer">
  <div class="footer-top">
    <div>
      <a class="logo" href={localeHref(locale)}>
        MPTour
      </a>
      <p lang={copyLang}>{dict.footer.place.text}</p>
    </div>
    <div>
      <a class="phone" href={whatsappHref(locale)} target="_blank" rel="noopener noreferrer">
        {WHATSAPP_DISPLAY}
      </a>
      <LocaleSwitch locale={locale} />
    </div>
  </div>
  <p lang={copyLang}>{dict.footer.legal.text}</p>
  <p>
    <a class="credits-link" data-testid="credits-link" href={creditsHref} lang={copyLang}>
      {dict.footer.credits.text}
    </a>
  </p>
  <p>© {year} MPTour</p>
</footer>
