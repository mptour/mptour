---
import type { Locale } from '../config/whatsapp';
import type { Dictionary } from '../i18n';
import { chrome } from '../i18n';
import { localeHref, sectionHref } from '../lib/paths';
import LocaleSwitch from './LocaleSwitch.astro';

interface Props {
  locale: Locale;
  dict: Dictionary;
}

const { locale, dict } = Astro.props;
const links = [
  { href: sectionHref(locale, 'territorios'), label: dict.nav.territories.text },
  { href: sectionHref(locale, 'experiencias'), label: dict.nav.experiences.text },
  { href: sectionHref(locale, 'como-funciona'), label: dict.nav.method.text },
];
---

<header class="header" data-header>
  <a class="logo" href={localeHref(locale)}>
    MPTour
  </a>
  <button
    class="menu-btn"
    type="button"
    data-nav-toggle
    aria-expanded="false"
    aria-controls="site-nav"
  >
    <span></span>
    <span></span>
    <span class="sr-only">{chrome[locale].menu.text}</span>
  </button>
  <nav id="site-nav" class="nav" data-nav aria-label="MPTour">
    {links.map((link) => (
      <a class="nav-link" href={link.href}>
        {link.label}
      </a>
    ))}
    <LocaleSwitch locale={locale} />
    <a class="header-cta" href={sectionHref(locale, 'plan')}>
      {dict.nav.cta.text}
    </a>
  </nav>
</header>
