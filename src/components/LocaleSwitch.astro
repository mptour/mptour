---
import { LOCALES, type Locale } from '../config/whatsapp';
import { chrome, htmlLang, isTranslated } from '../i18n';
import { localeHref } from '../lib/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const labels = { pt: 'PT', es: 'ES', en: 'EN' } as const;
---

<div class="locales">
  {LOCALES.map((code) => (
    <a
      href={localeHref(code)}
      data-testid={`locale-${code}`}
      hreflang={htmlLang[code]}
      lang={htmlLang[code]}
      aria-current={code === locale ? 'page' : undefined}
      data-draft={isTranslated(code) ? undefined : ''}
      title={isTranslated(code) ? undefined : chrome[locale].draft.text}
    >
      {labels[code]}
      {!isTranslated(code) && <span class="sr-only"> {chrome[locale].draft.text}</span>}
    </a>
  ))}
</div>
