---
import '../styles/global.css';
import fraunces from '@fontsource/fraunces/files/fraunces-latin-300-normal.woff2';
import frauncesItalic from '@fontsource/fraunces/files/fraunces-latin-300-italic.woff2';
import sans from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2';
import { WHATSAPP_DISPLAY, type Locale } from '../config/whatsapp';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { ogImageAlt } from '../assets/media';
import { chrome, htmlLang, notices, ogLocale, type Dictionary } from '../i18n';
import { loadHeroImages, mobileHeroSrc } from '../lib/hero-image';
import { absoluteUrl, alternatesFor } from '../lib/paths';

interface Props {
  locale: Locale;
  dict: Dictionary;
  title: string;
  description: string;
  untranslated?: boolean;
  preloadHero?: boolean;
}

const { locale, dict, title, description, untranslated = false, preloadHero = false } = Astro.props;
const heroImages = preloadHero ? await loadHeroImages(locale) : undefined;
const notice = untranslated && locale !== 'pt' ? notices[locale].text : undefined;
const alternates = alternatesFor(Astro.url.pathname);
const canonical = absoluteUrl(Astro.url.pathname);
const image = absoluteUrl(`${import.meta.env.BASE_URL}og.jpg`);
const home = absoluteUrl(import.meta.env.BASE_URL);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: 'MPTour',
  url: home,
  telephone: WHATSAPP_DISPLAY,
  areaServed: 'Foz do Iguaçu',
  description,
};
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {heroImages && (
      <link
        rel="preload"
        as="image"
        type="image/avif"
        href={mobileHeroSrc(heroImages.avif)}
        imagesrcset={heroImages.avif.srcSet.attribute}
        imagesizes={heroImages.sizes}
        fetchpriority="high"
      />
    )}
    <script is:inline>
      document.documentElement.classList.add('has-js');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js');
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {untranslated && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#0f2219" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt[locale]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    <link rel="preload" href={fraunces} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesItalic} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sans} as="font" type="font/woff2" crossorigin />
    {!untranslated && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <a class="skip" href="#main">
      {chrome[locale].skip.text}
    </a>
    <Header locale={locale} dict={dict} />
    {notice && (
      <p class="notice" data-testid="fallback-notice" lang={htmlLang[locale]}>
        {notice}
      </p>
    )}
    <slot />
    <Footer locale={locale} dict={dict} untranslated={untranslated} />
    <script>
      import { bindSite } from '../scripts/site.ts';
      bindSite(document, window);
    </script>
  </body>
</html>
